# Этап 5 (задача 5.1): пример Nginx как reverse-proxy перед Python-бэкендом.
#
# Зачем: встроенного сервера (python backend/server.py) достаточно для хакатона,
# но «взрослая» схема — Nginx отдаёт статику фронтенда напрямую, а /api/...
# проксирует на бэкенд. Скопируйте файл в conf.d Nginx и поправьте пути/порт.
#
# Установка на Windows: https://nginx.org/en/docs/windows.html
# Проверка конфига: nginx -t. Перезапуск: nginx -s reload.

upstream campus_api {
    server 127.0.0.1:8000;  # сюда смотрит python backend/server.py
}

server {
    listen 80;
    server_name _;

    # ПОПРАВЬТЕ: абсолютный путь к папке frontend проекта
    # Пример: root C:/Users/novik/OneDrive/Документы/хакатон1/frontend;
    root <ПУТЬ_К_ПРОЕКТУ>/frontend;

    # Задача 5.1: все /api/... уходят на бэкенд
    location /api/ {
        proxy_pass http://campus_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Все остальные запросы — статика фронтенда
    location / {
        try_files $uri $uri/ =404;
    }

    # Короткие ссылки из QR-кодов ведут на SPA (без них был бы 404)
    location /location/ {
        try_files $uri /index.html;
    }
    location /l/ {
        try_files $uri /index.html;
    }
}
